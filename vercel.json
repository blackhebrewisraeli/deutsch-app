{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/v1/league/settle.js": {
      "maxDuration": 300
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/v1/league/settle", "schedule": "0 0 * * 1" }
  ]
}
