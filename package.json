{
  "name": "deutsch-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "A bold, editorial-style German learning app powered by Claude AI",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ api/ supabase/",
    "lint:fix": "eslint src/ api/ supabase/ --fix",
    "test:rls": "vitest run --config vitest.rls.config.js",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "where": "node scripts/where.js",
    "audit:dead": "node scripts/audit-dead.js",
    "audit:contrast": "node scripts/dev/audit-contrast.mjs",
    "audit:layout": "node scripts/dev/audit-layout.mjs",
    "bench:perf": "node scripts/dev/bench-perf.mjs",
    "clean": "node scripts/clean.js",
    "prepare": "husky",
    "vendor:fonts": "node scripts/vendor-fonts/index.js",
    "import:lexicon": "node --max-old-space-size=4096 scripts/import-lexicon/index.js"
  },
  "dependencies": {
    "@sentry/react": "^10.59.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "api/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "supabase/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.7",
    "playwright": "^1.62.1",
    "prettier": "^3.8.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9",
    "ws": "^8.21.0"
  }
}
