{
  "name": "deutsch-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "A bold, editorial-style German learning app powered by Claude AI",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "echo \"Apify Actor Started Successfully\"",
    "lint": "eslint src/ api/ supabase/",
    "lint:fix": "eslint src/ api/ supabase/ --fix",
    "test:rls": "vitest run --config vitest.rls.config.js",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "where": "node scripts/where.js",
    "audit:dead": "node scripts/audit-dead.js",
    "audit:contrast": "node scripts/dev/audit-contrast.mjs",
    "audit:layout": "node scripts/dev/audit-layout.mjs",
    "smoke:learning-path": "node scripts/dev/smoke-learning-path.mjs",
    "smoke:auth-learning-path": "node scripts/dev/smoke-auth-learning-path.mjs",
    "bench:perf": "node scripts/dev/bench-perf.mjs",
    "clean": "node scripts/clean.js",
    "prepare": "husky || true",
    "vendor:fonts": "node scripts/vendor-fonts/index.js",
    "gen:assets": "node scripts/gen-assets/index.js",
    "check:migrations": "node scripts/check-migrations/index.js",
    "seed:lessons": "node scripts/seed-lessons/index.js",
    "import:lexicon": "node --max-old-space-size=4096 scripts/import-lexicon/index.js"
  },
  "dependencies": {
    "@sentry/react": "^10.59.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "api/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "supabase/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {}
}
