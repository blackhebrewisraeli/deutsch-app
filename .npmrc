# eslint-plugin-react@7.37.5 declares peer eslint ^3 || ... || ^9.7, but we
# use eslint@10. The plugin still works in practice; the version constraint is
# just out of date. Use legacy peer-dep resolution so `npm install` / `npm ci`
# don't fail on Vercel (which runs npm strictly).
#
# Revisit once eslint-plugin-react publishes a release with eslint@10 peer.
legacy-peer-deps=true
